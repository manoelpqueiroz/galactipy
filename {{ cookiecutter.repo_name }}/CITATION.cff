# CITATION.cff files can be generated and updated with cffinit:
# https://citation-file-format.github.io/cff-initializer-javascript/#/
cff-version: 1.2.0
title: {{ cookiecutter.project_name }}
message: >-
  If you use this software, please cite it using the
  metadata from this file.
type: software
authors:
  - name: {{ cookiecutter.maintainer }}
    email: {{ cookiecutter.email }}
repository-code: '{{ cookiecutter.__scm_repo_url }}'
repository: '{{ cookiecutter.__scm_repo_url }}'
abstract: >-
  {{ cookiecutter.project_description }}
{%- if cookiecutter.licence != 'nos' %}
license: {{ cookiecutter.licence }}
{%- else %}
license-url: '{{ cookiecutter.__scm_repo_url }}'  # UPDATEME with a link for your custom licence
{%- endif %}
{%- if cookiecutter.__schema_group == 'semver-like' %}
version: '0.1.0'  # UPDATEME with your latest version
{%- elif cookiecutter.version_schema == 'calver-auto' %}
version: '1{% now 'local', '%Y.%U' %}'  # UPDATEME with your latest version
{%- elif cookiecutter.version_schema == 'calver-explicit' %}
version: '1{% now 'local', '%Y.%m' %}'  # UPDATEME with your latest version
{%- elif cookiecutter.version_schema == 'solover' %}
version: '1'  # UPDATEME with your latest version
{%- endif %}
