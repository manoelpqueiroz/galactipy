{
  "project_name": "Python Project",
  "repo_name": "{{ cookiecutter.project_name.lower().split() | join('-') }}",
  "package_name": "{{ cookiecutter.repo_name.replace('-', '_') }}",
  "project_description": "{{ cookiecutter.project_name }} is a Python library created with https://gitlab.com/galactipy/galactipy",
  "copyright": "The Galactipy Contributors",
  "maintainer": "Manoel Pereira de Queiroz",
  "scm_platform": [
    "GitLab Free",
    "GitLab Premium/Ultimate",
    "GitHub"
  ],
  "scm_namespace": "galactipy",
  "email": "contact@{{ cookiecutter.scm_namespace.lower().split() | join('-') }}.com",
  "licence": [
    "MIT",
    "BSD-3-Clause",
    "GPL-3.0-or-later",
    "AGPL-3.0-or-later",
    "LGPL-3.0-or-later",
    "MPL-2.0",
    "Apache-2.0",
    "nos"
  ],
  "minimal_python_version": [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
    "3.14"
  ],
  "line_length": 88,
  "docstring_style": [
    "numpy",
    "google",
    "sphinx",
    "other"
  ],
  "docstring_length": "{{ cookiecutter.line_length }}",
  "version_schema": [
    "effver",
    "semver",
    "calver-auto",
    "calver-explicit",
    "romver",
    "solover",
    "trunkver"
  ],
  "commit_convention": [
    "gitmoji",
    "conventional",
    "conventional-gitmoji"
  ],
  "use_bdd": true,
  "coverage_service": [
    "Codacy",
    "Coveralls"
  ],
  "create_docker": true,
  "create_docs": true,
  "app_type": [
    "tui",
    "hybrid",
    "cli",
    "bare_cli",
    "bare_repo"
  ],

  "__prompts__": {
    "project_name": "Project name",
    "repo_name": "Project slug",
    "package_name": "Package name",
    "project_description": "Short description of the project",
    "copyright": "Copyright holder",
    "maintainer": "Project maintainer",
    "scm_platform": "In which platform would you like to host your code?",
    "scm_namespace": "Platform namespace",
    "email": "Contact email",
    "licence": {
      "__prompt__": "Which licence will you use for your project?",
      "MIT": "MIT Licence",
      "BSD-3-Clause": "3-Clause BSD",
      "GPL-3.0-or-later": "GNU GPL v3.0",
      "AGPL-3.0-or-later": "GNU AGPL v3.0",
      "LGPL-3.0-or-later": "GNU LGPL v3.0",
      "MPL-2.0": "Mozilla Public License 2.0",
      "Apache-2.0": "Apache Software License 2.0",
      "nos": "Non-OSS licence"
    },
    "minimal_python_version": "Minimal Python version",
    "line_length": "Maximum line length",
    "docstring_style": {
      "__prompt__": "Which docstring style would you like to use?",
      "numpy": "Numpydoc",
      "google": "Google Python Style",
      "sphinx": "Sphinx (reST Docstrings)",
      "other": "Other"
    },
    "docstring_length": "Docstring maximum line length",
    "use_bdd": "Use behaviour-driven development for testing?",
    "version_schema": {
      "__prompt__": "Which versioning schema will you use for development cycles?",
      "effver": "Intended Effort Versioning (EffVer)",
      "semver": "Semantic Versioning (SemVer)",
      "calver-auto": "Calendar Versioning (CalVer) – Automanaged by CI/CD",
      "calver-explicit": "Calendar Versioning (CalVer) – Explicit tags",
      "romver": "Romantic Versioning (RomVer)",
      "solover": "SoloVer",
      "trunkver": "TrunkVer"
    },
    "commit_convention": {
      "__prompt__": "Which commit convention would you like to use?",
      "gitmoji": "Gitmoji",
      "conventional": "Conventional Commits",
      "conventional-gitmoji": "Conventional Commits with Gitmoji"
    },
    "coverage_service": {
      "__prompt__": "What would you like to use for code quality services?",
      "Codacy": "Full code analysis with Codacy",
      "Coveralls": "Basic code coverage with Coveralls"
    },
    "create_docker": "Containerize your application with Docker?",
    "create_docs": "Provide documentation for your project with Zensical?",
    "app_type": {
      "__prompt__": "Which kind of application do you want to build?",
      "tui": "Integrated CLI+TUI",
      "hybrid": "Hybrid CLI/TUI",
      "cli": "CLI-only application",
      "bare_cli": "Minimal CLI structure",
      "bare_repo": "Bare repository"
    }
  },

  "_licence_mapping_simple": {
    "MIT": "MIT License",
    "BSD-3-Clause": "3-Clause BSD",
    "GPL-3.0-or-later": "GNU GPL 3.0",
    "AGPL-3.0-or-later": "GNU AGPL 3.0",
    "LGPL-3.0-or-later": "GNU LGPL 3.0",
    "MPL-2.0": "Mozilla Public License",
    "Apache-2.0": "Apache Software License",
    "nos": "a non-open-source licence"
  },
  "_licence_mapping_extended": {
    "MIT": "MIT License",
    "BSD-3-Clause": "BSD 3-Clause License",
    "GPL-3.0-or-later": "GNU General Public License v3.0 or later",
    "AGPL-3.0-or-later": "GNU Affero General Public License v3.0 or later",
    "LGPL-3.0-or-later": "GNU Lesser General Public License v3.0 or later",
    "MPL-2.0": "Mozilla Public License 2.0",
    "Apache-2.0": "Apache Software License 2.0",
    "nos": "a non-open-source licence"
  },
  "__licence_article": "{{ 'the ' if cookiecutter.licence in ['MIT', 'MPL-2.0', 'Apache-2.0'] else '' }}",
  "__licence_simple": "{{ cookiecutter._licence_mapping_simple[cookiecutter.licence] }}",
  "__licence_extended": "{{ cookiecutter._licence_mapping_extended[cookiecutter.licence] }}",

  "_python_version_list_mapping": {
    "3.10": [3, 10],
    "3.11": [3, 11],
    "3.12": [3, 12],
    "3.13": [3, 13],
    "3.14": [3, 14]
  },
  "_python_version_support_mapping": {
    "3.10": [[3, 10], [3, 11], [3, 12], [3, 13], [3, 14]],
    "3.11": [[3, 11], [3, 12], [3, 13], [3, 14]],
    "3.12": [[3, 12], [3, 13], [3, 14]],
    "3.13": [[3, 13], [3, 14]],
    "3.14": [[3, 14]]
  },
  "__mpvr": "{{ cookiecutter.minimal_python_version.replace('.', '') }}",

  "_version_schema_mapping": {
    "effver": "EffVer",
    "semver": "SemVer",
    "calver-auto": "CalVer",
    "calver-explicit": "CalVer",
    "romver": "RomVer",
    "solover": "SoloVer",
    "trunkver": "TrunkVer"
  },
  "_version_schema_mapping_formal": {
    "effver": "Intended Effort Versioning",
    "semver": "Semantic Versioning",
    "calver-auto": "Calendar Versioning",
    "calver-explicit": "Calendar Versioning",
    "romver": "Romantic Versioning",
    "solover": "SoloVer",
    "trunkver": "TrunkVer"
  },
  "_version_schemas_first_segment": {
    "effver": "MACRO",
    "semver": "MAJOR",
    "calver-auto": "YEAR",
    "calver-explicit": "YEAR",
    "romver": "PROJECT",
    "solover": null,
    "trunkver": null
  },
  "_version_schemas_second_segment": {
    "effver": "MESO",
    "semver": "MINOR",
    "calver-auto": "WEEK",
    "calver-explicit": "MINOR",
    "romver": "MAJOR",
    "solover": null,
    "trunkver": null
  },
  "_version_schemas_third_segment": {
    "effver": "MICRO",
    "semver": "PATCH",
    "calver-auto": null,
    "calver-explicit": "MICRO",
    "romver": "MINOR",
    "solover": null,
    "trunkver": null
  },
  "__schema_cipher": "{{ cookiecutter._version_schema_mapping[cookiecutter.version_schema] }}",
  "__schema_name": "{{ cookiecutter._version_schema_mapping_formal[cookiecutter.version_schema] }}",
  "__version_s1": "{{ cookiecutter._version_schemas_first_segment[cookiecutter.version_schema] }}",
  "__version_s2": "{{ cookiecutter._version_schemas_second_segment[cookiecutter.version_schema] }}",
  "__version_s3": "{{ cookiecutter._version_schemas_third_segment[cookiecutter.version_schema] }}",
  "__schema_type": "{{ 'simple' if cookiecutter.version_schema in ['solover', 'trunkver'] else 'segmented' }}",
  "__version_schema_base": "{{ 'calver' if 'calver' in cookiecutter.version_schema else cookiecutter.version_schema }}",
  "__schema_group": "{{ 'semver-like' if cookiecutter.__version_schema_base in ['effver', 'semver', 'romver'] else cookiecutter.__version_schema_base }}",

  "_app_type_mapping": {
    "tui": "tui",
    "hybrid": "tui",
    "cli": "cli",
    "bare_cli": "cli",
    "bare_repo": "bare_repo"
  },
  "_app_class_mapping": {
    "tui": "tui",
    "hybrid": "tui",
    "cli": "cli",
    "bare_cli": "bare",
    "bare_repo": "bare"
  },
  "__app_group": "{{ cookiecutter._app_type_mapping[cookiecutter.app_type] }}",
  "__app_class": "{{ cookiecutter._app_class_mapping[cookiecutter.app_type] }}",

  "__envvar": "{{ cookiecutter.package_name.upper() }}",
  "__security_email": "{{ cookiecutter.email.replace('.', ' dot ').replace('@', ' at ').replace('_', ' underscore ').replace('-', ' dash ') }}",

  "__scm_platform_base": "{{ 'GitLab' if 'GitLab' in cookiecutter.scm_platform else 'GitHub' }}",
  "__scm_platform_lc": "{{ cookiecutter.__scm_platform_base.lower() }}",
  "__scm_platform_redux": "{{ 'gl' if cookiecutter.__scm_platform_lc == 'gitlab' else 'gh' }}",
  "__scm_base_url": "https://{{ cookiecutter.__scm_platform_lc }}.com/{{ cookiecutter.scm_namespace }}/{{ cookiecutter.repo_name }}",
  "__scm_link_url": "https://{{ cookiecutter.__scm_platform_lc }}.com/{{ cookiecutter.scm_namespace }}/{{ cookiecutter.repo_name }}{% if cookiecutter.__scm_platform_lc == 'gitlab' %}/-{% endif %}",
  "__gitlab_org": "https://gitlab.com/groups/{{ cookiecutter.scm_namespace }}/-",
  "__gitlab_premium_templates": "https://gitlab.com/{{ cookiecutter.scm_namespace }}/templates/-/blob/master",
  "__contributing_prefix": "{{ cookiecutter.__gitlab_premium_templates ~ '/CONTRIBUTING.md' if cookiecutter.scm_platform == 'GitLab Premium/Ultimate' }}",

  "_roadmap_mapping": {
    "GitLab Premium/Ultimate": "epic",
    "GitLab Free": "milestone",
    "GitHub": "project"
  },
  "__roadmap_item": "{{ cookiecutter._roadmap_mapping[cookiecutter.scm_platform] }}",
  "__roadmap_item_indefinite": "{{ 'an ' ~ cookiecutter.__roadmap_item if cookiecutter.__roadmap_item == 'epic' else 'a ' ~ cookiecutter.__roadmap_item }}",

  "__docker_registry": "{{ 'registry.gitlab.com/' ~ cookiecutter.scm_namespace ~ '/' ~ cookiecutter.repo_name if cookiecutter.__scm_platform_lc == 'gitlab' else cookiecutter.scm_namespace ~ '/' ~ cookiecutter.repo_name }}",
  "__docker_repo": "{{ cookiecutter.__scm_base_url ~ '/container_registry' if cookiecutter.__scm_platform_lc == 'gitlab' else 'https://hub.docker.com/r/' ~ cookiecutter.scm_namespace ~ '/' ~ cookiecutter.repo_name }}",

  "__mr_term": "{{ 'Merge Request' if cookiecutter.__scm_platform_redux == 'gl' else 'Pull Request' }}",
  "__mr_acronym": "{{ 'MR' if cookiecutter.__scm_platform_redux == 'gl' else 'PR' }}",
  "__mr_term_slug": "{{ 'merge-request' if cookiecutter.__scm_platform_redux == 'gl' else 'pull-request' }}",
  "__task_item": "{{ 'task' if cookiecutter.__scm_platform_redux == 'gl' else 'sub-issue' }}",

  "__coverage_lc": "{{ cookiecutter.coverage_service.lower() }}",

  "_docstring_mapping": {
    "numpy": "numpydoc",
    "google": "Google Python Style",
    "sphinx": "Sphinx Style",
    "other": "custom"
  },
  "__docstring_name": "{{ cookiecutter._docstring_mapping[cookiecutter.docstring_style] }}",

  "__debug": false,
  "_copy_without_render": [
    "poetry.lock"
  ]
}
